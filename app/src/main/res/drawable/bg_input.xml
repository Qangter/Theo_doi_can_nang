<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">

            <solid android:color="@color/app_input_background" />

            <stroke
                android:width="2dp"
                android:color="@color/app_primary" />

            <corners android:radius="12dp" />

            <padding
                android:left="14dp"
                android:top="2dp"
                android:right="14dp"
                android:bottom="2dp" />

        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">

            <solid android:color="@color/app_input_background" />

            <stroke
                android:width="1dp"
                android:color="@color/app_card_border" />

            <corners android:radius="12dp" />

            <padding
                android:left="14dp"
                android:top="2dp"
                android:right="14dp"
                android:bottom="2dp" />

        </shape>
    </item>

</selector>