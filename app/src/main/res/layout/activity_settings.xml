<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ========================================= -->
        <!-- Tiêu đề -->
        <!-- ========================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cài đặt"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/app_text" />

        <!-- ========================================= -->
        <!-- Chiều cao -->
        <!-- ========================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Chiều cao (cm)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/app_text" />

        <EditText
            android:id="@+id/edtHeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ví dụ: 170"
            android:inputType="numberDecimal"
            android:autofillHints="height" />

        <!-- ========================================= -->
        <!-- Cân nặng ban đầu -->
        <!-- ========================================= -->

        <TextView
            android:id="@+id/tvStartWeightLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Cân nặng ban đầu (kg)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/app_text" />

        <EditText
            android:id="@+id/edtStartWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ví dụ: 70"
            android:inputType="numberDecimal"
            android:autofillHints="weight" />

        <!-- ========================================= -->
        <!-- Cân nặng mục tiêu -->
        <!-- ========================================= -->

        <TextView
            android:id="@+id/tvGoalWeightLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Cân nặng mục tiêu (kg)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/app_text" />

        <EditText
            android:id="@+id/edtGoalWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ví dụ: 65"
            android:inputType="numberDecimal"
            android:autofillHints="weight" />

        <!-- ========================================= -->
        <!-- Đơn vị cân nặng -->
        <!-- ========================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Đơn vị cân nặng"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/app_text" />

        <RadioGroup
            android:id="@+id/radioUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioKg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="kg"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioLbs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:text="lbs" />

        </RadioGroup>

        <!-- ========================================= -->
        <!-- Giao diện -->
        <!-- ========================================= -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:background="@color/app_secondary_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Giao diện"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/app_text" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchDarkMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Chế độ tối"
            android:textSize="16sp" />

        <!-- ========================================= -->
        <!-- Nhắc cân nặng -->
        <!-- ========================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Nhắc ghi nhận cân nặng"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/app_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Ứng dụng sẽ gửi thông báo mỗi ngày vào thời gian bạn chọn."
            android:textSize="14sp"
            android:textColor="@color/app_secondary_text" />

        <!-- ========================================= -->
        <!-- Chọn giờ -->
        <!-- ========================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Giờ nhắc"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/app_text" />

        <Button
            android:id="@+id/btnReminderTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="07:00" />

        <!-- ========================================= -->
        <!-- Bật / tắt nhắc nhở -->
        <!-- ========================================= -->

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchReminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Bật nhắc nhở hàng ngày"
            android:textSize="16sp" />

        <!-- ========================================= -->
        <!-- Lưu cài đặt -->
        <!-- ========================================= -->

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Lưu cài đặt" />

    </LinearLayout>

</ScrollView>